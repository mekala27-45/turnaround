# Copy to .env on the machine that runs the checks. Never commit .env.
# The live API runs on Vercel. DATABASE_URL, TURNAROUND_WRITE_TOKEN, TURNAROUND_DB_SCHEMA and
# TURNAROUND_CORS_ORIGINS are set in the Vercel project settings as well.
# The two Fly lines below serve only the former Fly route (deploy.ps1, deploy.sh), kept for history.
TURNAROUND_FLY_APP_NAME=turnaround-flights-api
FLY_API_TOKEN=
# Neon connection string; the API keeps its tables in the turnaround schema.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# The token that gates POST /v1/checks and POST /v1/score. Use the same value as in Vercel.
TURNAROUND_WRITE_TOKEN=
# Local test database for the persistence tests.
TURNAROUND_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/turnaround_test
