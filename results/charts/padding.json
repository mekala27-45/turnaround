 "source": "Source: BTS Reporting Carrier On-Time Performance, model: PELT changepoints, every scheduled flight, 2015 to 2026-07, as of 2026-10-01.",
 "sql": "with base as (\n        select carrier, make_date(cast(year as integer), cast(month as integer), 1) as period, padding,\n               padding - avg(padding) over (partition by carrier, route) as within,\n               avg(padding) over (partition by carrier) as overall\n        from wh.fct_flights where padding is not null\n    )\n    select carrier, period, count(*) as flights, avg(within) + any_value(overall) as padding\n    from base group by carrier, period order by carrier, period",
